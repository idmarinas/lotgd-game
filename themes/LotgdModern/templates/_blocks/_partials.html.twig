{# List of online characters #}
{% block online_list %}
	{{ 'online.list.title'|trans({ 'n': onlineCount }, textDomain)|colorize }}

	{% for row in list %}
		{{ '`^%s`0`n'|format(row.name)|colorize }}
	{% else %}
		{{ 'online.list.none'|trans({}, textDomain)|colorize }}
	{% endfor %}
{% endblock online_list %}

{# Stats of page generation #}
{% block game_page_gen %}
	{{ 'parts.pageGen'|trans({
		'genTime': genTime,
		'avg': avg,
		'userGenTime': userGenTime,
		'userGenTimeCount': userGenTimeCount
	}, 'app_default')|colorize }}
{% endblock game_page_gen %}

{# Menu of navigation with all links #}
{% block navigation_menu %}
	<nav role="navigation" class="navigation lotgd-border-image">
		{% for section, nav in navigation %}
			{% if nav|length > 0 or headers[section]['hiddeEmpty'] == false %}
				{% set sectionText = navigation_create_header(section, headers[section]) %}
				{% if sectionText %}
					{{ sectionText }}
				{% endif %}

				{% for key, label in nav %}
					{% set navText = navigation_create_link(label, navs[section][key]) %}
					{% if navText %}
						{{ navText }}
					{% endif %}
				{% endfor %}
			{% endif %}
		{% endfor %}
	</nav>
{% endblock navigation_menu %}

{% block pagination_stimulus %}

	{% if pageCount %}
		<div
			class="flex items-center justify-between sm:px-6 pagination mt-2"
		>
			<div class="flex-1 flex justify-between sm:hidden">
				<div class="items-center">
					{% if previous %}
						<!-- Link to first page -->
						<a
							class="items-center rounded-md" href
							aria-label="{{ 'parts.pagination.menu.first'|trans({}, 'app_default')|uncolorize }}"
							{{ stimulus_action(stimulus_controller, 'list') }}
							data-{{ stimulus_controller }}-page-param="{{ first }}"
						>
							{{ 'parts.pagination.menu.first'|trans({}, 'app_default')|uncolorize }}
						</a>

						<!-- Link to previous page -->
						<a
							class="items-center rounded-md" href
							{{ stimulus_action(stimulus_controller, 'list') }}
							data-{{ stimulus_controller }}-page-param="{{ previous }}"
						>
							{{ 'parts.pagination.menu.previous'|trans({}, 'app_default')|uncolorize }}
						</a>
					{% endif %}
				</div>
				<div class="items-center">
					{% if next %}
						<!-- Link to next page -->
						<a
							class="items-center rounded-md" href
							aria-label="{{ 'parts.pagination.menu.next'|trans({}, 'app_default')|uncolorize }}"
							{{ stimulus_action(stimulus_controller, 'list') }}
							data-{{ stimulus_controller }}-page-param="{{ next }}"
						>
							{{ 'parts.pagination.menu.next'|trans({}, 'app_default')|uncolorize }}
						</a>
						<!-- Link to last page -->
						<a
							class="items-center rounded-md" href
							aria-label="{{ 'parts.pagination.menu.last'|trans({}, 'app_default')|uncolorize }}"
							{{ stimulus_action(stimulus_controller, 'list') }}
							data-{{ stimulus_controller }}-page-param="{{ last }}"
						>
							{{ 'parts.pagination.menu.last'|trans({}, 'app_default')|trans|uncolorize }}
						</a>
					{% endif %}
				</div>
			</div>

			<div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
				<div>
					<p>
						{{ 'parts.pagination.menu.showing'|trans({ firstItemNumber, lastItemNumber, totalItemCount }, 'app_default')
						|colorize }}
					</p>
				</div>
				<div>
					<nav
						class="overflow-auto shadow-sm -space-x-px"
						aria-label="{{ 'parts.pagination.description'|trans({ 'firstItemNumber': firstItemNumber,
							'lastItemNumber': lastItemNumber, 'totalItemCount': totalItemCount }, 'app_default')|uncolorize }}"
					>
						{% if previous %}
							<a
								class="items-center px-2 py-2" href
								{{ stimulus_action(stimulus_controller, 'list') }}
								data-{{ stimulus_controller }}-page-param="{{ previous }}"
							>
								<span class="sr-only">{{ 'parts.pagination.menu.previous'|trans({}, 'app_default')|uncolorize }}</span>
								<i aria-hidden="true" class="fas fa-chevron-left"></i>
							</a>
						{% endif %}
						<!-- Links to number pages -->
						{% for page in pagesInRange %}
							{% if page != current %}
								<a
									aria-label="{{ 'parts.pagination.menu.page'|trans({'page': page}, 'app_default')|uncolorize }}"
									class="items-center " href
									{{ stimulus_action(stimulus_controller, 'list') }}
									data-{{ stimulus_controller }}-page-param="{{ page }}"
								>
									{{ page }}
								</a>
							{% else %}
								<a
									aria-current="{{ 'parts.pagination.menu.page'|trans({'page': page}, 'app_default')|uncolorize }}"
									class="current items-center "
								>
									{{ page }}
								</a>
							{% endif %}
						{% endfor %}

						{% if next %}
							<a
								class="items-center px-2 py-2" href
								{{ stimulus_action(stimulus_controller, 'list') }}
								data-{{ stimulus_controller }}-page-param="{{ next }}"
							>
								<span class="sr-only">{{ 'parts.pagination.menu.next'|trans({}, 'app_default')|uncolorize }}</span>
								<i aria-hidden="true" class="fas fa-chevron-right"></i>
							</a>
						{% endif %}
					</nav>
				</div>
			</div>
		</div>
	{% endif %}

{% endblock pagination_stimulus %}

{% block pagination %}
	{% if pageCount %}
		<div class="flex items-center justify-between sm:px-6 pagination mt-2">
			<div class="flex-1 flex justify-between sm:hidden">
				<div class="items-center">
					{% if previous %}
						<!-- Link to first page -->
						<a
							class="items-center rounded-md"
							aria-label="{{ 'parts.pagination.menu.first'|trans({}, 'app_default')|uncolorize }}"
							href="{{ (href ~ 'page=' ~ first)|lotgd_url }}"
						>
							{{ 'parts.pagination.menu.first'|trans({}, 'app_default')|uncolorize }}
						</a>

						<!-- Link to previous page -->
						<a class="items-center rounded-md" href="{{ (href ~ 'page=' ~ previous)|lotgd_url }}">
							{{ 'parts.pagination.menu.previous'|trans({}, 'app_default')|uncolorize }}
						</a>
					{% endif %}
				</div>
				<div class="items-center">
					{% if next %}
						<!-- Link to next page -->
						<a
							class="items-center rounded-md"
							aria-label="{{ 'parts.pagination.menu.next'|trans({}, 'app_default')|uncolorize }}"
							href="{{ (href ~ 'page=' ~ next)|lotgd_url }}"
						>
							{{ 'parts.pagination.menu.next'|trans({}, 'app_default')|uncolorize }}
						</a>
						<!-- Link to last page -->
						<a
							class="items-center rounded-md"
							aria-label="{{ 'parts.pagination.menu.last'|trans({}, 'app_default')|uncolorize }}"
							href="{{ (href ~ 'page=' ~ last)|lotgd_url }}"
						>
							{{ 'parts.pagination.menu.last'|trans({}, 'app_default')|uncolorize }}
						</a>
					{% endif %}
				</div>
			</div>

			<div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
				<div>
					<p>
						{{ 'parts.pagination.menu.showing'|trans({ firstItemNumber, lastItemNumber, totalItemCount }, 'app_default')
						|colorize }}
					</p>
				</div>
				<div>
					<nav
						class="overflow-auto shadow-sm -space-x-px"
