									aria-label="{{ 'parts.pagination.menu.page'|trans({'page': page}, 'app_default')|uncolorize }}"
									href="{{ (href ~ 'page=' ~ page)|lotgd_url }}"
									class="items-center "
								>
									{{ page }}
								</a>
							{% else %}
								<a
									aria-current="{{ 'parts.pagination.menu.page'|trans({'page': page}, 'app_default')|uncolorize }}"
									class="current items-center "
								>
									{{ page }}
								</a>
							{% endif %}
						{% endfor %}

						{% if next %}
							<a href="{{ (href ~ 'page=' ~ next)|lotgd_url }}" class="items-center px-2 py-2   ">
								<span class="sr-only">{{ 'parts.pagination.menu.next'|trans({}, 'app_default')|uncolorize }}</span>
								<i aria-hidden="true" class="fas fa-chevron-right"></i>
							</a>
						{% endif %}
					</nav>
				</div>
			</div>
		</div>
	{% endif %}
{% endblock pagination %}

{% block ad_wrapper %}
	<div class="lotgd-border-image">{{ ad_content }}</div>
{% endblock ad_wrapper %}
